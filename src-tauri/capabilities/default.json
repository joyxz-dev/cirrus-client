{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Cirrus capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "fs:allow-create",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:scope-appdata-recursive",
    "dialog:default",
    "process:default",
    "store:default",
    "http:default",
    "log:default"
  ]
}
